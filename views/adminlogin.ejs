<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | <%= siteName %></title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="stylesheet" href="/css/redesign.css">
</head>
<body>
    <%- include('includes/nav.ejs') %>
    <main class="flex justify-center items-center
                 px-6 py-14">

        <div class="w-full max-w-md
                    bg-white
                    rounded-2xl
                    shadow-lg
                    border border-[#dcecf7]
                    p-8">

            <div class="text-center mb-7">
                <div class="w-14 h-14 mx-auto mb-4
                            rounded-full
                            bg-[#e8f4fc]
                            flex items-center justify-center">

                    <i class="fa-solid fa-user-lock
                              text-xl text-[#18577f]">
                    </i>
                </div>

                <h1 class="text-3xl font-bold
                           text-[#123f63]"
                    style="font-family: Georgia, serif;">
                    Admin Login
                </h1>
                <p class="text-gray-500 mt-2 text-sm">Login to manage your bookstore</p>
            </div>

            <form action="/admin/login" method="POST">
                <div class="mb-5">
                    <label class="block text-sm font-semibold text-[#123f63]  mb-2"></label>
                    <div class="relative">
                        <i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2  text-[#18577f]"> </i>
                        <input type="text" name="username" required  placeholder="Enter username"
                            class="w-full
                                   pl-11 pr-4 py-3
                                   rounded-xl
                                   border border-[#c9dfed]
                                   outline-none
                                   text-gray-700
                                   focus:border-[#18577f]
                                   focus:ring-2
                                   focus:ring-[#dceefa]
                                   transition">
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-semibold text-[#123f63] mb-2"> Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock  absolute left-4 top-1/2 -translate-y-1/2 text-[#18577f]"></i>
                        <input type="password"  name="password" required placeholder="Enter password"
                            class="w-full
                                   pl-11 pr-4 py-3
                                   rounded-xl
                                   border border-[#c9dfed]
                                   outline-none
                                   text-gray-700
                                   focus:border-[#18577f]
                                   focus:ring-2
                                   focus:ring-[#dceefa]
                                   transition">
                    </div>
                </div>

                <button type="submit"
                    class="w-full
                           py-3
                           rounded-xl
                           bg-[#18577f]
                           text-white
                           font-semibold
                           flex items-center
                           justify-center
                           gap-2
                           cursor-pointer
                           hover:bg-[#123f63]
                           transition">

                    <i class="fa-solid fa-right-to-bracket"></i>
                    Login
                </button>
            </form>
            <p class="text-center
                      text-xs
                      text-gray-400
                      mt-5">
                <i class="fa-solid fa-shield-halved
                          text-[#18577f] mr-1">
                </i>
                Authorized access only
            </p>
        </div>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>