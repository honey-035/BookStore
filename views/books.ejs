<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title>Books | <%= siteName %></title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="stylesheet" href="/css/redesign.css">
</head>
<body class="min-h-screen bg-[#eef7ff]">
    <%- include('includes/nav.ejs') %>
    <main class="max-w-6xl mx-auto px-6 py-10">
        <div class="flex justify-between items-center mb-8">
            <div>
                <p class="text-sm font-semibold
                          text-[#18577f]
                          uppercase
                          tracking-wider">
                    Our Collection
                </p>

                <h1 class="text-3xl font-bold
                           text-[#123f63] mt-1"
                    style="font-family: Georgia, serif;">
                    Explore Our Books
                </h1>

                <p class="text-gray-600 mt-2">Discover stories, ideas and books you'll love.</p>
            </div>

            <% if(isAdmin) { %>

                <a href="/books/new"  class="inline-flex items-center gap-2
                          px-5 py-2.5
                          rounded-full
                          bg-[#18577f]
                          text-white
                          font-semibold
                          shadow-sm
                          hover:bg-[#123f63]
                          transition">
                    <i class="fa-solid fa-plus"></i>
                    Add New Book
                </a>
                <a href="/admin/logout"  class="inline-flex items-center gap-2
                          px-5 py-2.5
                          rounded-full
                          bg-[#18577f]
                          text-white
                          font-semibold
                          shadow-sm
                          hover:bg-[#123f63]
                          transition">
                    Logout
                </a>
            <% } %>
        </div>


        <div class="grid grid-cols-1
                    sm:grid-cols-2
                    lg:grid-cols-3
                    gap-6">
            <% books.forEach(books => { %>

                <div class="bg-white
                            rounded-2xl
                            overflow-hidden
                            shadow-sm
                            border border-[#dcecf7]
                            hover:shadow-lg
                            hover:-translate-y-1
                            transition duration-300">

                    <div class="h-60
                                bg-[#f1f8fc]
                                flex items-center
                                justify-center
                                overflow-hidden
                                relative">

                        <img
                            src="<%= books.img.startsWith('/') ? books.img : '/' + books.img %>"
                            class="w-full h-full
                                   object-contain
                                   hover:scale-105
                                   transition duration-500"
                        >

                        <span class="absolute top-3 left-3
                                     px-3 py-1
                                     rounded-full
                                     bg-white
                                     text-[#18577f]
                                     text-xs
                                     font-bold
                                     shadow-sm">

                            <%= books.category %>
                        </span>
                    </div>

                    <div class="p-5">
                        <h2 class="text-lg font-bold
                                   text-[#123f63]"
                            style="font-family: Georgia, serif;">
                            <%= books.title %>
                        </h2>

                        <p class="text-gray-500 text-sm mt-2">
                            <i class="fa-solid fa-pen-nib
                                      text-[#18577f] mr-1">
                            </i>
                            <%= books.author %>
                        </p>

                        <div class="flex justify-between
                                    items-center mt-4">
                            <div>

                                <p class="text-xs text-gray-400
                                          uppercase tracking-wide">
                                    Price
                                </p>

                                <p class="text-xl font-bold
                                          text-[#18577f]">
                                    ₹ <%= books.price %>
                                </p>
                            </div>

                            <div class="text-right">
                                <p class="text-xs text-gray-400">
                                    Category
                                </p>

                                <p class="text-sm font-semibold
                                          text-[#164e78]">
                                    <%= books.category %>
                                </p>
                            </div>
                        </div>

                        <form action="/cart/add/<%= books._id %>"
                              method="post"
                              class="mt-5">
                            <button
                                type="submit"
                                class="w-full py-2.5
                                       rounded-xl
                                       bg-[#18577f]
                                       text-white
                                       font-semibold
                                       flex items-center
                                       justify-center
                                       gap-2
                                       cursor-pointer
                                       hover:bg-[#123f63]
                                       transition">
                                <i class="fa-solid fa-cart-plus"></i>
                                Add to Cart
                            </button>
                        </form>


                        <% if(isAdmin) { %>
                            <div class="flex gap-3 mt-3">
                                <form action="/books/edit/<%= books._id %>"
                                      method="get"
                                      class="flex-1">

                                    <button
                                        type="submit"
                                        class="w-full py-2
                                               rounded-xl
                                               border border-[#c9dfed]
                                               text-[#18577f]
                                               font-semibold
                                               cursor-pointer
                                               hover:bg-[#eef7ff]
                                               transition">

                                        <i class="fa-solid fa-pen-to-square"></i>
                                        Edit
                                    </button>
                                </form>

                                <form action="/books/delete/<%= books._id %>"
                                      method="post"
                                      class="flex-1">

                                    <button
                                        type="submit"
                                        class="w-full py-2
                                               rounded-xl
                                               border border-red-200
                                               text-red-500
                                               font-semibold
                                               cursor-pointer
                                               hover:bg-red-50
                                               transition">
                                        <i class="fa-solid fa-trash"></i>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>